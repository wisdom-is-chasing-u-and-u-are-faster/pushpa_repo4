# Environment Configuration — Next-Generation Digital Banking Platform
# Port and Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
LOG_LEVEL=info

# Database Configuration (Defaults to SQLite for local development, supports PostgreSQL in production)
DATABASE_URL=sqlite:///./digital_banking.db

# Security & FAPI Token Secrets
SECRET_KEY=change-in-production-secret-token-value
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Distributed Invariant & Reconciler Timing
INVARIANT_CHECK_INTERVAL_SECONDS=60
STEP_UP_MFA_THRESHOLD_USD=10000.00
